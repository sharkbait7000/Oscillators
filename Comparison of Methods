import matplotlib.pyplot as plt


def acceleration(x, omega):
    return -omega**2 * x


def explicit_euler(x0, v0, omega, dt, steps):
    x = x0
    v = v0

    xs, vs, energies, times = [], [], [], []
    t = 0.0

    for _ in range(steps):
        a = acceleration(x, omega)

        x = x + v * dt
        v = v + a * dt

        E = 0.5 * v**2 + 0.5 * (omega * x)**2

        xs.append(x)
        vs.append(v)
        energies.append(E)
        times.append(t)

        t += dt

    return times, xs, vs, energies


def semi_implicit_euler(x0, v0, omega, dt, steps):
    x = x0
    v = v0

    xs, vs, energies, times = [], [], [], []
    t = 0.0

    for _ in range(steps):
        a = acceleration(x, omega)

        v = v + a * dt
        x = x + v * dt

        E = 0.5 * v**2 + 0.5 * (omega * x)**2

        xs.append(x)
        vs.append(v)
        energies.append(E)
        times.append(t)

        t += dt

    return times, xs, vs, energies


def velocity_verlet(x0, v0, omega, dt, steps):
    x = x0
    v = v0

    xs, vs, energies, times = [], [], [], []
    t = 0.0

    for _ in range(steps):
        a = acceleration(x, omega)

        x_new = x + v * dt + 0.5 * a * dt**2
        a_new = acceleration(x_new, omega)
        v_new = v + 0.5 * (a + a_new) * dt

        x = x_new
        v = v_new

        E = 0.5 * v**2 + 0.5 * (omega * x)**2

        xs.append(x)
        vs.append(v)
        energies.append(E)
        times.append(t)

        t += dt

    return times, xs, vs, energies


# -----------------------------
# Run comparison
# -----------------------------

x0 = 1.0
v0 = 0.0
omega = 1.0
dt = 0.05
steps = 1000

methods = {
    "Explicit Euler": explicit_euler,
    "Semi-Implicit Euler": semi_implicit_euler,
    "Velocity Verlet": velocity_verlet,
}


for name, method in methods.items():
    times, xs, vs, energies = method(x0, v0, omega, dt, steps)

    plt.plot(xs, vs, label=name)

plt.xlabel("x")
plt.ylabel("v")
plt.title("Phase Space Comparison")
plt.legend()
plt.show()


