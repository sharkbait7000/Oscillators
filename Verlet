import matplotlib.pyplot as plt

# Initial conditions
x = 1.0
v = 0.0
omega = 1.0
dt = 0.01

positions = []
velocities = []
energies = []
times = []

t = 0

for i in range(200000):
    # 1. acceleration at current position
    a = -omega**2 * x

    # 2. update position
    x_new = x + v * dt + 0.5 * a * dt**2

    # 3. new acceleration
    a_new = -omega**2 * x_new

    # 4. update velocity (average acceleration)
    v_new = v + 0.5 * (a + a_new) * dt

    # move forward
    x = x_new
    v = v_new

    # energy
    E = 0.5 * v**2 + 0.5 * (omega * x)**2

    positions.append(x)
    velocities.append(v)
    energies.append(E)
    times.append(t)

    t += dt

# Phase space
plt.plot(positions, velocities)
plt.xlabel("x")
plt.ylabel("v")
plt.title("Phase Space (Verlet)")
plt.show()

# Energy
plt.plot(times, energies)
plt.xlabel("time")
plt.ylabel("energy")
plt.title("Energy (Verlet)")
plt.show()
