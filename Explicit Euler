import matplotlib.pyplot as plt

x = 1.0
v = 0.0
m = 1.0
k = 1.0
omega = 1.0
dt = 0.01

positions = []
times = []
velocities = []
energies = []

t = 0

for i in range(200000):
    a = -omega**2 * x
    x = x + v* dt
    v = v + a * dt
    E = 0.5*m*v**2 + 0.5*k*x**2

    energies.append(E)
    velocities.append(v)
    positions.append(x)
    times.append(t)

    t = t + dt


plt.plot(positions, velocities)
plt.xlabel("velocities")
plt.ylabel("positions")
plt.show()

plt.plot(times, energies)
plt.xlabel("time")
plt.ylabel("energy")
plt.show()
